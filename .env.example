# ==============================================================================
# VARIABLES DE ENTORNO - EDUCARESPONDE (VITE + REACT)
# ==============================================================================
# Copia este archivo como ".env" en la raíz del proyecto para desarrollo local
# o configura estas variables en Vercel / antes de compilar para HostGator.

# URL del Aula Virtual Moodle
# - En producción (HostGator): https://aula.educaresponde.cl/login/index.php
# - En pruebas locales (Moodle local / Laragon / XAMPP): http://localhost:8080/login/index.php o http://moodle.test/login/index.php
VITE_MOODLE_URL=https://aula.educaresponde.cl/login/index.php

# Número de WhatsApp comercial (formato internacional sin símbolo '+' ni espacios)
VITE_WHATSAPP_NUMBER=56912345678

# Correo institucional de contacto y cotizaciones B2B
VITE_CONTACT_EMAIL=contacto@educaresponde.cl

# (Opcional) Endpoint PHP en HostGator para procesar formulario de contacto por servidor
# Ejemplo en producción: https://educaresponde.cl/procesar_contacto.php
VITE_CONTACT_API_URL=
